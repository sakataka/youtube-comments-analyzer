{
  "name": "youtube-comment-mention-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 0",
    "dev:e2e": "VITE_BACKEND_URL=http://127.0.0.1:8011 VITE_AUTO_AI_ASSIST=0 vite --host 127.0.0.1 --port 4175 --mode e2e",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 0",
    "test": ".venv/bin/python -m unittest discover -s backend/tests",
    "eval:sentiment": ".venv/bin/python backend/tools/evaluate_sentiment_models.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3"
  }
}
