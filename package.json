{
  "name": "youtube-comment-mention-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 0",
    "dev:e2e": "VITE_BACKEND_URL=http://127.0.0.1:8011 VITE_AUTO_AI_ASSIST=0 vite --host 127.0.0.1 --port 4175 --mode e2e",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 0",
    "test": ".venv/bin/python -m unittest discover -s backend/tests",
    "test:live": ".venv/bin/python -m unittest discover -s backend/live_tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
